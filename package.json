{
  "name": "tree-sitter-monkeyc",
  "version": "0.1.0",
  "description": "Monkey C grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "monkey-c",
    "connect-iq"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "bindings/node/*",
    "bindings/rust/*",
    "queries/**",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "node-gyp": "13.0.2",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.25.3"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "generate": "tree-sitter generate",
    "build": "node-gyp rebuild",
    "test": "tree-sitter test && npm run build && node --test bindings/node/binding_test.js",
    "check:sources": "node scripts/check-sources"
  }
}
